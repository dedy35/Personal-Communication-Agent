# Shared
APP_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=8000
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=1.5

# PostgreSQL
POSTGRES_DB=pca
POSTGRES_USER=pca_user
POSTGRES_PASSWORD=pca_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://pca_user:pca_password@localhost:5432/pca

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
